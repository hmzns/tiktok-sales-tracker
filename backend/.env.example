DATABASE_URL="postgresql://username:password@host:port/database?schema=public"
DIRECT_URL="postgresql://username:password@host:port/database?schema=public"
ALLOWED_ORIGINS=http://localhost:8081,https://your-cloudflare-pages-url.pages.dev
APP_API_KEY=replace-with-a-secure-random-api-key
TIKTOK_SHOP_APP_KEY=replace-with-your-app-key
TIKTOK_SHOP_APP_SECRET=replace-with-your-app-secret
TIKTOK_SHOP_AUTHORIZATION_URL=https://services.tiktokshop.com/open/authorize?service_id=replace-with-your-service-id
TIKTOK_SHOP_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get
TIKTOK_SHOP_REFRESH_URL=https://auth.tiktok-shops.com/api/v2/token/refresh
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_SUCCESS_REDIRECT_URL=https://your-frontend.example.com/settings/integrations/tiktok-shop/success
TIKTOK_SHOP_FAILURE_REDIRECT_URL=https://your-frontend.example.com/settings/integrations/tiktok-shop/failure
TIKTOK_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

PORT=3000
