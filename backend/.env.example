# Required: PostgreSQL connection used by Prisma at runtime and for migrations.
DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# Required: credential expected in the x-api-key request header.
APP_API_KEY=replace-with-a-long-random-api-key

# Required in production: comma-separated browser origins, without trailing slashes.
ALLOWED_ORIGINS=http://localhost:8081,https://your-project.pages.dev

# Required for TikTok Shop integration.
TIKTOK_SHOP_APP_KEY=replace-with-your-tiktok-app-key
TIKTOK_SHOP_APP_SECRET=replace-with-your-tiktok-app-secret
TIKTOK_SHOP_AUTHORIZATION_URL=https://services.tiktokshop.com/open/authorize?service_id=replace-with-your-service-id
# Base64 encoding of exactly 32 random bytes; keep this stable after tokens are stored.
TIKTOK_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional TikTok endpoint overrides; the defaults shown match the current integration.
TIKTOK_SHOP_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get
TIKTOK_SHOP_REFRESH_URL=https://auth.tiktok-shops.com/api/v2/token/refresh
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com

# Optional HTTPS destinations after the public OAuth callback succeeds or fails.
TIKTOK_SHOP_SUCCESS_REDIRECT_URL=https://your-frontend.example.com/
TIKTOK_SHOP_FAILURE_REDIRECT_URL=https://your-frontend.example.com/

# Optional standalone sync lookback (1-30 days; invalid or missing values use 2).
TIKTOK_AUTO_SYNC_DAYS=2

# Optional process settings. Render supplies PORT; TZ keeps business dates in Malaysia time.
PORT=3000
NODE_ENV=development
TZ=Asia/Kuching
