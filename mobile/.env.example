# Public frontend configuration. EXPO_PUBLIC_* values are embedded in the web bundle.
# Never place TikTok secrets, database credentials, or encryption keys here.

# Browser development example. For Expo Go, replace localhost with the computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Intentionally public under the current single-seller architecture; must match APP_API_KEY.
EXPO_PUBLIC_BACKEND_API_KEY=replace-with-the-same-api-key-used-in-backend
